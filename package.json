{
  "name": "@kryptopay/sdk",
  "version": "0.1.0-beta.1",
  "description": "TypeScript SDK for launching KryptoPay checkout in web apps.",
  "license": "UNLICENSED",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KryptoPaySDK/sdk.git"
  },
  "homepage": "https://kryptopay.xyz",
  "bugs": {
    "url": "https://github.com/KryptoPaySDK/sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "kryptopay",
    "payments",
    "checkout",
    "crypto",
    "react",
    "sdk"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier -w ."
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.56.0"
  },
  "dependencies": {
    "viem": "^2.45.3"
  }
}